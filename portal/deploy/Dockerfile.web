# Portal Neoguard — imagem do Nginx: SPA do portal em / + Gerador de Propostas em /propostas/.
# Contexto de build: a RAIZ do repositório (veja o .dockerignore da raiz).
#   docker build -f portal/deploy/Dockerfile.web --build-arg GIT_SHA=$(git rev-parse HEAD) -t portal-neoguard-web .

# ---- Estágio 1: build do frontend (React + Vite) ----
FROM node:22-alpine AS frontend

WORKDIR /build

# Dependências primeiro, para aproveitar o cache de camadas.
COPY portal/frontend/package.json portal/frontend/package-lock.json ./
RUN npm ci

COPY portal/frontend/ ./
RUN npm run build


# ---- Estágio 2: Nginx com a SPA e o Gerador ----
FROM nginx:1.27-alpine

# Configuração do Nginx e cabeçalhos de segurança compartilhados.
COPY portal/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY portal/deploy/nginx-seguranca.conf /etc/nginx/snippets/seguranca.conf

# SPA do portal na raiz.
COPY --from=frontend /build/dist/ /usr/share/nginx/html/

# Gerador de Propostas estático em /propostas/. SEM data/: o cadastro real nunca entra na
# imagem, ele chega por volume (CADASTRO_DIR) montado em /usr/share/nginx/html/propostas/data.
COPY index.html /usr/share/nginx/html/propostas/index.html
COPY js/ /usr/share/nginx/html/propostas/js/
COPY assets/ /usr/share/nginx/html/propostas/assets/

# Versão em uso: o Gerador lê propostas/version.json e mostra no topo da página. Fica no fim
# para um commit novo não invalidar o cache das camadas acima.
ARG GIT_SHA=dev
LABEL com.neoguard.projeto="portal-neoguard" \
      com.neoguard.servico="web" \
      org.opencontainers.image.revision="${GIT_SHA}"
RUN mkdir -p /usr/share/nginx/html/propostas/data \
 && chmod -R a+rX /usr/share/nginx/html /etc/nginx/conf.d /etc/nginx/snippets \
 && printf '{\n  "version": "portal-%s",\n  "commit": "%s",\n  "built_at": "%s"\n}\n' \
      "$(printf '%s' "${GIT_SHA}" | cut -c1-7)" "${GIT_SHA}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      > /usr/share/nginx/html/propostas/version.json

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1/"]
