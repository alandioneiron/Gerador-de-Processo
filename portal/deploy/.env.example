# Portal Neoguard — configuração do servidor.
# No servidor: copie para /opt/portal-neoguard/.env, preencha e proteja (chmod 600).
# NUNCA commite o .env real: ele tem senhas.

# ---- Banco (PostgreSQL) -------------------------------------------------------------------------
# Use uma senha só com letras e números (ex.: openssl rand -hex 24). Caracteres como @ : / # %
# quebram a DATABASE_URL montada pelo docker-compose.yml.
POSTGRES_USER=portal
POSTGRES_PASSWORD=
POSTGRES_DB=portal

# ---- Endereço e porta ---------------------------------------------------------------------------
# PORTAL_URL é o endereço que vai nos links dos e-mails (PORTAL_URL/fichas/<id>).
PORTAL_URL=http://172.16.100.35:8090
# Porta publicada no servidor (HTTP, só rede interna). Na Fase 2 ela é fechada.
PORTAL_PORTA=8090

# ---- Cadastro real do Gerador de Propostas ------------------------------------------------------
# Pasta do servidor com config.json, ccts.json, municipios.json e site.json. Fica FORA do git e
# da imagem; o contêiner a recebe por volume, somente leitura.
CADASTRO_DIR=/opt/portal-neoguard/cadastro

# ---- E-mail de notificação ----------------------------------------------------------------------
# Destinatários (separados por vírgula) dos avisos da Ficha de Implantação.
NOTIFICAR_PARA=ti@neoguard.com.br,suporte@neoguard.com.br,aux.ti@neoguard.com.br

# SMTP. Com SMTP_HOST vazio o portal não envia e-mail (registra "e-mail não configurado" no log).
# SMTP_PORT vazio = 587 e SMTP_TLS vazio = starttls. SMTP_TLS aceita: starttls | ssl | nenhum.
SMTP_HOST=
SMTP_PORT=
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
SMTP_TLS=
