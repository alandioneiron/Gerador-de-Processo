# Copie para .env (não vai para o git). Valores de exemplo.
DATABASE_URL=sqlite:///./portal-dev.db
# Produção: postgresql+psycopg://portal:SENHA@db:5432/portal
PORTAL_URL=http://172.16.100.35:8090
NOTIFICAR_PARA=ti@neoguard.com.br,suporte@neoguard.com.br,aux.ti@neoguard.com.br
# Sem SMTP_HOST nenhum e-mail é enviado (o "Enviar ficha por e-mail" devolve 502).
# Produção: mail.neoguard.com.br, porta 465, SSL implícito.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
# Aceita "Nome <email>"
SMTP_REMETENTE=
# starttls | ssl | nenhum
SMTP_TLS=starttls
SMTP_VERIFICAR_CERTIFICADO=true
GIT_SHA=dev
